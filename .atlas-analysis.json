  "keyFeatures": [
    "AI documentation generation from source code",
    "Bidirectional GitHub sync with branch previews",
    "Block-based editor for technical writing",
    "OpenAPI / interactive API reference generation",
    "One-click edge deployment via Cloudflare (300+ locations)",
    "Evergreen docs — GitHub Action auto-updates docs on every commit",
    "Real-time collaboration with inline comments and role-based access",
    "CLI for scripting and CI/CD pipeline integration",
    "One-click migration from GitBook and Mintlify",
    "Full-text client-side search"
  ],
  "publicApiSurface": [
    "npx create-inkloom@latest <project-name>",
    "inkloom deploy <project-id> --production",
    "inkloom/docs-action@v1 (GitHub Action)",
    "GET /api/v1/projects",
    "POST /api/v1/projects",
    "GET /api/v1/projects/:id/pages",
    "POST /api/v1/projects/:id/pages",
    "POST /api/v1/projects/:id/deployments",
    "GET /api/v1/deployments/:id"
  ]
}
