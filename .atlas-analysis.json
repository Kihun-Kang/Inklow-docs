{
  "projectType": "saas",
  "projectName": "InkLoom",
  "projectDescription": "InkLoom is an AI-powered documentation platform that automatically generates, syncs, and deploys your docs from your codebase via GitHub integration.",
  "theme": "luma",
  "primaryColor": "#1be49c",
  "lightColor": "#0c8c5c",
